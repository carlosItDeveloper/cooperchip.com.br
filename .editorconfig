root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.psm1]
end_of_line = crlf

[*.psd1]
end_of_line = crlf

[*.cs]
csharp_style_prefer_top_level_statements = false:suggestion
